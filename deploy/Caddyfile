# DV Cloud: веб-контейнер. Отдаёт сайт (папка /srv) и пересылает /api на сервер облака.
# HTTPS здесь не нужен: его даёт ваш внешний прокси (см. docs/DEPLOY.md).
{
	admin off
	auto_https off
	servers {
		# Внешний прокси перед этим контейнером: верим его заголовку X-Forwarded-For,
		# чтобы сервер облака видел настоящий адрес человека (иначе все входы выглядят как один адрес).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Заголовки безопасности для всего сайта
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}

	# API: на сервер облака. Загрузки большие и долгие, поэтому ответы не буферизуются.
	handle /api/* {
		reverse_proxy {$DVCLOUD_UPSTREAM:server:3004} {
			flush_interval -1
		}
	}

	# Остальное: сайт. Любой неизвестный путь отдаёт index.html (одностраничное приложение).
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
