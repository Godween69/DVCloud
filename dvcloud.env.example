# Скопируй в dvcloud.env (он в .gitignore) и поменяй пароль и токен. Не коммить dvcloud.env.
# Пароль базы и токен можно сгенерировать: openssl rand -hex 24
POSTGRES_USER=dvcloud
POSTGRES_PASSWORD=поменяй-меня
POSTGRES_DB=dvcloud

# Публичный порт сервера (вход, API для сайта и приложения).
DVCLOUD_HOST=127.0.0.1
DVCLOUD_PORT=3004
# Внутренний порт для админки: наружу не публиковать. Токен не короче 32 символов.
DVCLOUD_INTERNAL_HOST=127.0.0.1
DVCLOUD_INTERNAL_PORT=3006
DVCLOUD_INTERNAL_TOKEN=поменяй-токен
DVCLOUD_DATABASE_URL=postgres://dvcloud:поменяй-меня@127.0.0.1:5436/dvcloud
DVCLOUD_DATA_DIR=./data

# Кука входа с флагом Secure. Для разработки по http можно false, в работе только true.
DVCLOUD_COOKIE_SECURE=false
# Сколько прокси стоит перед сервером (нужно, чтобы видеть настоящий адрес клиента).
DVCLOUD_TRUST_PROXY=0
DVCLOUD_SESSION_IDLE_DAYS=14

DVCLOUD_ADMIN_HOST=127.0.0.1
DVCLOUD_ADMIN_PORT=3005
